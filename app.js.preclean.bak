}\n\nfunction renderReportValueChart() {
    const container = document.getElementById('report-value-chart');
    const catValues = categories.map(cat => {
        const value = products
            .filter(p => p.categoryId === cat.id)
            .reduce((sum, p) => sum + (p.salePrice * p.quantity), 0);
        return { ...cat, value };
    }).filter(c => c.value > 0).sort((a, b) => b.value - a.value);

    if (catValues.length === 0) {
        container.innerHTML = '<div class="chart-empty"><i class="fa-solid fa-chart-bar"></i><span>Sem dados para exibir</span></div>';
        return;
    }

    const maxValue = Math.max(...catValues.map(c => c.value));

    container.innerHTML = catValues.map(cat => {
        const pct = Math.max((cat.value / maxValue) * 100, 8);
        return `<div class="h-chart-item">
            <span class="h-chart-label">${cat.icon} ${cat.name}</span>
            <div class="h-chart-bar-wrap">
                <div class="h-chart-bar" style="width:${pct}%; background: linear-gradient(90deg, ${cat.color}, ${cat.color}99);">${formatCurrency(cat.value)}</div>
            </div>
        </div>`;
    }).join('');
