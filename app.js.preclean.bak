}\n\nfunction confirmDeleteProduct(id) {
    const product = getProductById(id);
    if (!product) return;
    
    // Verificar se existem movimentações associadas
    const movementsCount = movements.filter(m => m.productId === id).length;
    
    pendingDeleteId = id;
    pendingDeleteType = 'product';
    
    if (movementsCount > 0) {
        document.getElementById('confirm-message').textContent = `❌ Não é possível excluir "${product.name}"\n\nExistem ${movementsCount} movimentação(ões) associada(s).`;
        document.getElementById('confirm-delete-btn').disabled = true;
    } else {
        document.getElementById('confirm-message').textContent = `Tem certeza que deseja excluir "${product.name}"?`;
        document.getElementById('confirm-delete-btn').disabled = false;
    }
    
    openModal('confirm-modal');
