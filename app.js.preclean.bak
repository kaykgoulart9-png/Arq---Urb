}\n\nfunction exportCSV() {
    const headers = ['Nome', 'Marca', 'Categoria', 'Volume', 'PreÃ§o Compra', 'PreÃ§o Venda', 'Estoque', 'Estoque MÃ­n', 'Fornecedor', 'Status'];
    const rows = products.map(p => {
        const cat = getCategoryById(p.categoryId);
        const status = getStockStatus(p);
        return [
            p.name, p.brand || '', cat ? cat.name : '', p.volume,
            p.purchasePrice.toFixed(2), p.salePrice.toFixed(2),
            p.quantity, p.minStock, p.supplier || '', status.label
        ];
    });

    const csvContent = [headers, ...rows].map(row =>
        row.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(',')
    ).join('\n');

    const BOM = '\uFEFF';
    const blob = new Blob([BOM + csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `bevstock_estoque_${new Date().toISOString().split('T')[0]}.csv`;
    link.click();
    URL.revokeObjectURL(url);

    showToast('RelatÃ³rio exportado com sucesso!', 'success');
}


