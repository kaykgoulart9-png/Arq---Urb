}\n\nfunction renderKPIs() {
    const totalProducts = products.length;
    const stockValue = products.reduce((sum, p) => sum + (p.salePrice * p.quantity), 0);
    const lowStockCount = products.filter(p => {
        const status = getStockStatus(p);
        return status.level === 'low' || status.level === 'critical' || status.level === 'empty';
    }).length;
    const movementsToday = movements.filter(m => isToday(m.date)).length;

    animateValue('kpi-total-products', totalProducts);
    document.getElementById('kpi-stock-value').textContent = formatCurrency(stockValue);
    animateValue('kpi-low-stock', lowStockCount);
    animateValue('kpi-movements-today', movementsToday);

    // Update notification badge
    const badge = document.getElementById('notification-badge');
    if (lowStockCount > 0) {
        badge.textContent = lowStockCount;
        badge.classList.remove('hidden');
    } else {
        badge.classList.add('hidden');
    }
