}\n\nfunction renderReportLowStock() {
    const tbody = document.getElementById('report-low-stock-body');
    const lowProducts = products.filter(p => {
        const status = getStockStatus(p);
        return status.level !== 'ok';
    }).sort((a, b) => a.quantity - b.quantity);

    if (lowProducts.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6"><div class="empty-state-sm"><i class="fa-solid fa-circle-check"></i> Todos os produtos com estoque adequado</div></td></tr>';
        return;
    }

    tbody.innerHTML = lowProducts.map(p => {
        const cat = getCategoryById(p.categoryId);
        const status = getStockStatus(p);
        const deficit = Math.max(0, p.minStock - p.quantity);
        const suggestion = deficit > 0 ? `Repor ${deficit} un` : 'Monitorar';

        return `<tr>
            <td class="fw-bold">${p.name}</td>
            <td>${cat ? cat.icon + ' ' + cat.name : 'â€”'}</td>
            <td class="${status.level === 'empty' || status.level === 'critical' ? 'text-danger' : 'text-warning'} fw-bold">${p.quantity}</td>
            <td>${p.minStock}</td>
            <td><span class="badge ${status.class}">${status.label}</span></td>
            <td><span class="text-accent fw-bold">${suggestion}</span></td>
        </tr>`;
    }).join('');
