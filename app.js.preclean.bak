}\n\nfunction renderDashboardMovements() {
    const tbody = document.getElementById('dashboard-movements-body');
    const recent = movements.slice(0, 8);

    if (recent.length === 0) {
        tbody.innerHTML = '<tr class="empty-row"><td colspan="4"><div class="empty-state-sm"><i class="fa-solid fa-inbox"></i> Nenhuma movimentaÃ§Ã£o</div></td></tr>';
        return;
    }

    tbody.innerHTML = recent.map(mov => {
        const product = getProductById(mov.productId);
        const productName = product ? product.name : 'Produto removido';
        const typeClass = mov.type === 'entry' ? 'badge-entry' : 'badge-exit';
        const typeLabel = mov.type === 'entry' ? 'â†“ Entrada' : 'â†‘ SaÃ­da';
        const qtyPrefix = mov.type === 'entry' ? '+' : '-';

        return `<tr>
            <td><span class="fw-bold">${productName}</span></td>
            <td><span class="badge ${typeClass}">${typeLabel}</span></td>
            <td><span class="${mov.type === 'entry' ? 'text-success' : 'text-danger'} fw-bold">${qtyPrefix}${mov.quantity}</span></td>
            <td class="text-muted">${formatDate(mov.date)}</td>
        </tr>`;
    }).join('');
