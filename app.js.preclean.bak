}\n\nfunction renderReportMostMoved() {
    const container = document.getElementById('report-most-moved');
    const movCounts = {};

    movements.forEach(m => {
        movCounts[m.productId] = (movCounts[m.productId] || 0) + m.quantity;
    });

    const sorted = Object.entries(movCounts)
        .map(([id, count]) => ({ product: getProductById(id), count }))
        .filter(item => item.product)
        .sort((a, b) => b.count - a.count)
        .slice(0, 7);

    if (sorted.length === 0) {
        container.innerHTML = '<div class="chart-empty"><i class="fa-solid fa-fire"></i><span>Sem dados</span></div>';
        return;
    }

    const maxCount = sorted[0].count;

    container.innerHTML = sorted.map((item, i) => {
        const pct = (item.count / maxCount) * 100;
        return `<div class="most-moved-item">
            <span class="most-moved-rank">#${i + 1}</span>
            <div class="most-moved-info">
                <div class="most-moved-name">${item.product.name}</div>
                <div class="most-moved-bar-wrap">
                    <div class="most-moved-bar" style="width:${pct}%"></div>
                </div>
            </div>
            <span class="most-moved-count">${item.count} un</span>
        </div>`;
    }).join('');
