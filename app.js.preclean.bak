}\n\nfunction renderReportSummary() {
    const container = document.getElementById('report-summary-stats');

    const totalProducts = products.length;
    const totalCategories = categories.length;
    const totalUnits = products.reduce((s, p) => s + p.quantity, 0);
    const stockValuePurchase = products.reduce((s, p) => s + (p.purchasePrice * p.quantity), 0);
    const stockValueSale = products.reduce((s, p) => s + (p.salePrice * p.quantity), 0);
    const potentialProfit = stockValueSale - stockValuePurchase;
    const avgPrice = totalProducts > 0 ? stockValueSale / totalProducts : 0;
    const totalMovements = movements.length;

    container.innerHTML = `
        <div class="stat-item"><span class="stat-label">Produtos Cadastrados</span><span class="stat-value">${totalProducts}</span></div>
        <div class="stat-item"><span class="stat-label">Categorias</span><span class="stat-value">${totalCategories}</span></div>
        <div class="stat-item"><span class="stat-label">Unidades em Estoque</span><span class="stat-value">${totalUnits.toLocaleString('pt-BR')}</span></div>
        <div class="stat-item"><span class="stat-label">Valor Custo</span><span class="stat-value">${formatCurrency(stockValuePurchase)}</span></div>
        <div class="stat-item"><span class="stat-label">Valor Venda</span><span class="stat-value text-accent">${formatCurrency(stockValueSale)}</span></div>
        <div class="stat-item"><span class="stat-label">Lucro Potencial</span><span class="stat-value text-success">${formatCurrency(potentialProfit)}</span></div>
        <div class="stat-item"><span class="stat-label">PreÃ§o MÃ©dio Venda</span><span class="stat-value">${formatCurrency(avgPrice)}</span></div>
        <div class="stat-item"><span class="stat-label">Total MovimentaÃ§Ãµes</span><span class="stat-value">${totalMovements}</span></div>
    `;
}


