}\n\nfunction getFilteredMovements() {
    const search = document.getElementById('movement-search').value.toLowerCase().trim();
    const typeFilter = document.getElementById('movement-filter-type').value;
    const dateStart = document.getElementById('movement-date-start').value;
    const dateEnd = document.getElementById('movement-date-end').value;

    return movements.filter(m => {
        if (typeFilter && m.type !== typeFilter) return false;
        if (search) {
            const product = getProductById(m.productId);
            const productName = product ? product.name.toLowerCase() : '';
            if (!productName.includes(search) && !m.reason.toLowerCase().includes(search)) return false;
        }
        if (dateStart) {
            const mDate = new Date(m.date).toISOString().split('T')[0];
            if (mDate < dateStart) return false;
        }
        if (dateEnd) {
            const mDate = new Date(m.date).toISOString().split('T')[0];
            if (mDate > dateEnd) return false;
        }
        return true;
    });
