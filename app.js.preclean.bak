}\n\nfunction setupFilters() {
    // Product filters
    ['product-search', 'product-filter-category', 'product-filter-stock'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', () => renderProducts());
    });

    // Movement filters
    ['movement-search', 'movement-filter-type', 'movement-date-start', 'movement-date-end'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener(el.tagName === 'SELECT' || el.type === 'date' ? 'change' : 'input', () => renderMovements());
    });
}


