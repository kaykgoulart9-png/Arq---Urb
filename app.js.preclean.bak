}\n\nfunction saveMovement(e) {
    e.preventDefault();
    const type = document.getElementById('movement-type').value;
    const productId = document.getElementById('movement-product').value;
    const quantity = parseInt(document.getElementById('movement-quantity').value) || 0;
    const reason = document.getElementById('movement-reason').value;
    const notes = document.getElementById('movement-notes').value.trim();

    if (!productId || quantity <= 0 || !reason) {
        showToast('Preencha todos os campos obrigatÃ³rios', 'error');
        return;
    }

    const product = getProductById(productId);
    if (!product) {
        showToast('Produto nÃ£o encontrado', 'error');
        return;
    }

    if (type === 'exit' && quantity > product.quantity) {
        showToast(`Estoque insuficiente! DisponÃ­vel: ${product.quantity} unidades`, 'error');
        return;
    }

    // Update stock
    if (type === 'entry') {
        product.quantity += quantity;
    } else {
        product.quantity -= quantity;
    }

    // Create movement record
    const movement = {
        id: generateId(),
        productId,
        type,
        quantity,
        reason,
        notes,
        date: new Date().toISOString(),
    };

    movements.unshift(movement);
    saveData(STORAGE_KEYS.products, products);
    saveData(STORAGE_KEYS.movements, movements);

    closeModal('movement-modal');
    showToast(
        `${type === 'entry' ? 'Entrada' : 'SaÃ­da'} de ${quantity}x "${product.name}" registrada!`,
        type === 'entry' ? 'success' : 'warning'
    );

    // Refresh current page
    const activePage = document.querySelector('.page.active');
    if (activePage) {
        const pageId = activePage.id.replace('page-', '');
        navigateTo(pageId);
    }
}


