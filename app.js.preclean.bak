}\n\nfunction saveProduct(e) {
    e.preventDefault();
    const id = document.getElementById('product-id').value;
    const productData = {
        name: document.getElementById('product-name').value.trim(),
        brand: document.getElementById('product-brand').value.trim(),
        categoryId: document.getElementById('product-category').value,
        volume: document.getElementById('product-volume').value.trim(),
        purchasePrice: parseFloat(document.getElementById('product-purchase-price').value) || 0,
        salePrice: parseFloat(document.getElementById('product-sale-price').value) || 0,
        minStock: parseInt(document.getElementById('product-min-stock').value) || 0,
        quantity: parseInt(document.getElementById('product-quantity').value) || 0,
        supplier: document.getElementById('product-supplier').value.trim(),
        description: document.getElementById('product-description').value.trim(),
        sku: (document.getElementById('product-sku') && document.getElementById('product-sku').value.trim()) || '',
        expiryDate: (document.getElementById('product-expiry-date') && document.getElementById('product-expiry-date').value) || '',
    };

    // ===== VALIDAÇÕES CRÍTICAS =====
    if (!productData.name) {
        showToast('Nome do produto é obrigatório', 'error');
        return;
    }

    if (productData.purchasePrice >= productData.salePrice) {
        showToast('❌ Preço de venda deve ser MAIOR que preço de compra!', 'error');
        return;
    }

    if (productData.minStock < 0) {
        showToast('Estoque mínimo não pode ser negativo', 'error');
        return;
    }

    if (productData.quantity < 0) {
        showToast('Quantidade não pode ser negativa', 'error');
        return;
    }

    // Validar produtos duplicados (apenas ao criar novo)
    if (!id) {
        const duplicate = products.some(p => p.name.toLowerCase() === productData.name.toLowerCase());
        if (duplicate) {
            showToast(`⚠️ Um produto com o nome "${productData.name}" já existe!`, 'warning');
            return;
        }
    }

    if (!productData.categoryId) {
        showToast('Selecione uma categoria', 'error');
        return;
    }

    if (id) {
        const index = products.findIndex(p => p.id === id);
        if (index !== -1) {
            products[index] = { ...products[index], ...productData };
            showToast(`Produto "${productData.name}" atualizado!`, 'success');
        }
    } else {
        productData.id = generateId();
        products.push(productData);
        showToast(`Produto "${productData.name}" cadastrado!`, 'success');
    }

    saveData(STORAGE_KEYS.products, products);
    closeModal('product-modal');
    renderProducts();
}\r\n\r\nfunction executeDelete() {
