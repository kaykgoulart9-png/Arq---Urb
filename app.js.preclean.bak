}\n\nfunction getStockStatus(product) {
    if (product.quantity === 0) return { label: 'Sem Estoque', class: 'badge-empty', level: 'empty' };
    if (product.quantity <= Math.floor(product.minStock * 0.3)) return { label: 'CrÃ­tico', class: 'badge-critical', level: 'critical' };
    if (product.quantity <= product.minStock) return { label: 'Baixo', class: 'badge-low', level: 'low' };
    return { label: 'OK', class: 'badge-ok', level: 'ok' };
