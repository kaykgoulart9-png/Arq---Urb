}\n\nfunction saveCategory(e) {
    e.preventDefault();
    const id = document.getElementById('category-id').value;
    const catData = {
        name: document.getElementById('category-name').value.trim(),
        icon: document.getElementById('category-icon').value.trim() || 'ðŸ“¦',
        color: document.getElementById('category-color').value,
    };

    if (!catData.name) {
        showToast('Informe o nome da categoria', 'error');
        return;
    }

    if (id) {
        const index = categories.findIndex(c => c.id === id);
        if (index !== -1) {
            categories[index] = { ...categories[index], ...catData };
            showToast(`Categoria "${catData.name}" atualizada!`, 'success');
        }
    } else {
        catData.id = generateId();
        categories.push(catData);
        showToast(`Categoria "${catData.name}" criada!`, 'success');
    }

    saveData(STORAGE_KEYS.categories, categories);
    closeModal('category-modal');
    renderCategories();
