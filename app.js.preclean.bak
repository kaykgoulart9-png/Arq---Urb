}\n\nfunction renderProducts() {
    populateCategorySelects();
    const tbody = document.getElementById('products-table-body');
    let filtered = getFilteredProducts();

    if (filtered.length === 0) {
        tbody.innerHTML = '<tr class="empty-row"><td colspan="7"><div class="empty-state"><i class="fa-solid fa-boxes-stacked"></i><h3>Nenhum produto encontrado</h3><p>Ajuste os filtros ou cadastre novos produtos</p></div></td></tr>';
        return;
    }

    tbody.innerHTML = filtered.map(p => {
        const cat = getCategoryById(p.categoryId);
        const status = getStockStatus(p);
        const catIcon = cat ? cat.icon : 'ðŸ“¦';
        const catColor = cat ? cat.color : '#666';
        const catName = cat ? cat.name : 'Sem categoria';

        return `<tr>
            <td>
                <div class="product-cell">
                    <div class="product-icon" style="background:${catColor}20; color:${catColor}">${catIcon}</div>
                    <div class="product-info">
                        <span class="product-name">${p.name}</span>
                        <span class="product-brand">${p.brand || ''} ${p.volume ? 'â€¢ ' + p.volume : ''}</span>
                    </div>
                </div>
            </td>
            <td>${catName}</td>
            <td>${formatCurrency(p.purchasePrice)}</td>
            <td class="fw-bold">${formatCurrency(p.salePrice)}</td>
            <td class="fw-bold">${p.quantity}</td>
            <td><span class="badge ${status.class}">${status.label}</span></td>
            <td>
                <div class="table-actions">
                    <button class="btn-icon-sm entry" title="Nova entrada" onclick="openQuickEntry('${p.id}')"><i class="fa-solid fa-arrow-down"></i></button>
                    <button class="btn-icon-sm edit" title="Editar" onclick="editProduct('${p.id}')"><i class="fa-solid fa-pen"></i></button>
                    <button class="btn-icon-sm delete" title="Excluir" onclick="confirmDeleteProduct('${p.id}')"><i class="fa-solid fa-trash"></i></button>
                </div>
            </td>
        </tr>`;
    }).join('');
