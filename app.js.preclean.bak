}\n\nfunction openMovementModal(type = 'entry') {
    const form = document.getElementById('movement-form');
    const title = document.getElementById('movement-modal-title');
    const header = document.getElementById('movement-modal-header');
    const submitBtn = document.getElementById('submit-movement-btn');

    form.reset();
    document.getElementById('movement-type').value = type;

    // Populate products select
    const select = document.getElementById('movement-product');
    select.innerHTML = '<option value="">Selecione um produto</option>';
    products.forEach(p => {
        const cat = getCategoryById(p.categoryId);
        const catIcon = cat ? cat.icon : 'ðŸ“¦';
        select.innerHTML += `<option value="${p.id}">${catIcon} ${p.name} (estoque: ${p.quantity})</option>`;
    });

    // Populate reasons
    const reasonSelect = document.getElementById('movement-reason');
    const entryReasons = ['Compra de fornecedor', 'DevoluÃ§Ã£o de cliente', 'Ajuste de inventÃ¡rio', 'TransferÃªncia entre unidades', 'BonificaÃ§Ã£o', 'Outro'];
    const exitReasons = ['Venda', 'Quebra/Avaria', 'Vencimento', 'Consumo interno', 'Ajuste de inventÃ¡rio', 'TransferÃªncia', 'Outro'];

    reasonSelect.innerHTML = '<option value="">Selecione</option>';
    (type === 'entry' ? entryReasons : exitReasons).forEach(r => {
        reasonSelect.innerHTML += `<option value="${r}">${r}</option>`;
    });

    if (type === 'entry') {
        title.innerHTML = '<i class="fa-solid fa-arrow-down"></i> Nova Entrada';
        header.className = 'modal-header entry';
        submitBtn.className = 'btn btn-success';
        submitBtn.innerHTML = '<i class="fa-solid fa-arrow-down"></i> Registrar Entrada';
    } else {
        title.innerHTML = '<i class="fa-solid fa-arrow-up"></i> Nova SaÃ­da';
        header.className = 'modal-header exit';
        submitBtn.className = 'btn btn-danger';
        submitBtn.innerHTML = '<i class="fa-solid fa-arrow-up"></i> Registrar SaÃ­da';
    }

    openModal('movement-modal');
