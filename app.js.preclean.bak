}\n\nfunction renderMovements() {
    const tbody = document.getElementById('movements-table-body');
    let filtered = getFilteredMovements();

    if (filtered.length === 0) {
        tbody.innerHTML = '<tr class="empty-row"><td colspan="6"><div class="empty-state"><i class="fa-solid fa-arrow-right-arrow-left"></i><h3>Nenhuma movimentaÃ§Ã£o</h3><p>Registre entradas ou saÃ­das</p></div></td></tr>';
        return;
    }

    tbody.innerHTML = filtered.map(mov => {
        const product = getProductById(mov.productId);
        const productName = product ? product.name : 'Produto removido';
        const isEntry = mov.type === 'entry';

        return `<tr>
            <td>${formatDateTime(mov.date)}</td>
            <td class="fw-bold">${productName}</td>
            <td><span class="badge ${isEntry ? 'badge-entry' : 'badge-exit'}">${isEntry ? 'â†“ Entrada' : 'â†‘ SaÃ­da'}</span></td>
            <td class="${isEntry ? 'text-success' : 'text-danger'} fw-bold">${isEntry ? '+' : '-'}${mov.quantity}</td>
            <td>${mov.reason}</td>
            <td class="text-muted">${mov.notes || 'â€”'}</td>
        </tr>`;
    }).join('');
