}\n\nfunction renderReportWeekChart() {
    const container = document.getElementById('report-week-chart');
    const days = [];
    const dayLabels = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'SÃ¡b'];
    const now = new Date();

    for (let i = 6; i >= 0; i--) {
        const date = new Date(now);
        date.setDate(date.getDate() - i);
        const dateStr = date.toISOString().split('T')[0];
        const dayName = dayLabels[date.getDay()];

        const entries = movements.filter(m => m.type === 'entry' && m.date.startsWith(dateStr)).reduce((sum, m) => sum + m.quantity, 0);
        const exits = movements.filter(m => m.type === 'exit' && m.date.startsWith(dateStr)).reduce((sum, m) => sum + m.quantity, 0);

        days.push({ dateStr, dayName, entries, exits, isToday: i === 0 });
    }

    const maxVal = Math.max(...days.map(d => Math.max(d.entries, d.exits)), 1);

    container.innerHTML = days.map(d => {
        const entryH = Math.max((d.entries / maxVal) * 100, 2);
        const exitH = Math.max((d.exits / maxVal) * 100, 2);

        return `<div class="week-day">
            <div class="week-day-bars">
                <div class="week-bar entries" style="height:${d.entries > 0 ? entryH : 2}%" data-count="â†“${d.entries}"></div>
                <div class="week-bar exits" style="height:${d.exits > 0 ? exitH : 2}%" data-count="â†‘${d.exits}"></div>
            </div>
            <span class="week-label" style="${d.isToday ? 'color:var(--accent);font-weight:700' : ''}">${d.dayName}</span>
        </div>`;
    }).join('') + `
    <div style="position:absolute;top:0;right:0;display:flex;gap:1rem;font-size:0.7rem;color:var(--text-muted)">
        <span style="display:flex;align-items:center;gap:4px"><span style="width:10px;height:10px;border-radius:2px;background:var(--success)"></span>Entradas</span>
        <span style="display:flex;align-items:center;gap:4px"><span style="width:10px;height:10px;border-radius:2px;background:var(--danger)"></span>SaÃ­das</span>
    </div>`;

    container.style.position = 'relative';
