        movements = movements.filter(m => m.productId !== pendingDeleteId);
        saveData(STORAGE_KEYS.products, products);
        saveData(STORAGE_KEYS.movements, movements);
        showToast(`Produto "${product?.name}" excluído`, 'warning');
        renderProducts();
    } else if (pendingDeleteType === 'category') {
        const cat = getCategoryById(pendingDeleteId);
        const hasProducts = products.some(p => p.categoryId === pendingDeleteId);
        if (hasProducts) {
            showToast('Remova todos os produtos desta categoria primeiro!', 'error');
        } else {
