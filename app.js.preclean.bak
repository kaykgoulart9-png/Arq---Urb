            showToast(`Categoria "${cat?.name}" excluída`, 'warning');
            renderCategories();
        }
    }

    pendingDeleteId = null;
    pendingDeleteType = null;
    closeModal('confirm-modal');
}\n\nfunction confirmDeleteCategory(id) {
    const cat = getCategoryById(id);
    if (!cat) return;
    const productCount = products.filter(p => p.categoryId === id).length;

    pendingDeleteId = id;
    pendingDeleteType = 'category';

    if (productCount > 0) {
        document.getElementById('confirm-message').textContent = `A categoria "${cat.name}" possui ${productCount} produto(s). Remova os produtos antes de excluir.`;
    } else {
        document.getElementById('confirm-message').textContent = `Excluir a categoria "${cat.name}"?`;
    }
    openModal('confirm-modal');
}


