}\n\nfunction renderCategories() {
    const container = document.getElementById('categories-grid');

    if (categories.length === 0) {
        container.innerHTML = '<div class="empty-state" style="grid-column: 1/-1"><i class="fa-solid fa-tags"></i><h3>Nenhuma categoria</h3><p>Crie categorias para organizar seus produtos</p></div>';
        return;
    }

    container.innerHTML = categories.map(cat => {
        const productCount = products.filter(p => p.categoryId === cat.id).length;
        const totalStock = products.filter(p => p.categoryId === cat.id).reduce((sum, p) => sum + p.quantity, 0);

        return `<div class="category-card">
            <div class="cat-actions">
                <button class="btn-icon-sm edit" title="Editar" onclick="editCategory('${cat.id}')"><i class="fa-solid fa-pen"></i></button>
                <button class="btn-icon-sm delete" title="Excluir" onclick="confirmDeleteCategory('${cat.id}')"><i class="fa-solid fa-trash"></i></button>
            </div>
            <span class="cat-icon">${cat.icon}</span>
            <span class="cat-name">${cat.name}</span>
            <span class="cat-count">${productCount} produto${productCount !== 1 ? 's' : ''} â€¢ ${totalStock} un em estoque</span>
            <div class="cat-bar" style="background: linear-gradient(90deg, ${cat.color}, ${cat.color}40)"></div>
        </div>`;
    }).join('');
