    const container = document.getElementById('notification-list');
    const alertProducts = products.filter(p => {
        const status = getStockStatus(p);
        return status.level !== 'ok';
    }).sort((a, b) => a.quantity - b.quantity);

    if (alertProducts.length === 0) {
        container.innerHTML = '<div class="notification-empty"><i class="fa-solid fa-circle-check"></i><span>Nenhum alerta ativo</span></div>';
        return;
    }

    container.innerHTML = alertProducts.map(p => {
        const status = getStockStatus(p);
        const isCritical = status.level === 'critical' || status.level === 'empty';
        const cat = getCategoryById(p.categoryId);

        return `<div class="notification-item">
            <div class="notif-icon ${isCritical ? 'critical' : 'warning'}">
                <i class="fa-solid fa-${isCritical ? 'circle-exclamation' : 'triangle-exclamation'}"></i>
            </div>
            <div class="notif-info">
                <div class="notif-title">${p.name}</div>
                <div class="notif-desc">${cat ? cat.icon + ' ' + cat.name : ''} â€¢ Estoque: ${p.quantity} un (mÃ­n: ${p.minStock})</div>
            </div>
        </div>`;
    }).join('');
