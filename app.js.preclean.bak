}\n\nfunction renderTopProducts() {
    const container = document.getElementById('top-products-list');
    const sorted = [...products]
        .map(p => ({ ...p, totalValue: p.salePrice * p.quantity }))
        .sort((a, b) => b.totalValue - a.totalValue)
        .slice(0, 5);

    if (sorted.length === 0 || sorted[0].totalValue === 0) {
        container.innerHTML = '<div class="chart-empty"><i class="fa-solid fa-ranking-star"></i><span>Cadastre produtos</span></div>';
        return;
    }

    const rankClasses = ['gold', 'silver', 'bronze', 'normal', 'normal'];

    container.innerHTML = sorted.map((p, i) => {
        const cat = getCategoryById(p.categoryId);
        return `<div class="top-product-item">
            <span class="top-rank ${rankClasses[i]}">${i + 1}</span>
            <div class="top-product-info">
                <div class="top-product-name">${p.name}</div>
                <div class="top-product-cat">${cat ? cat.icon + ' ' + cat.name : ''}</div>
            </div>
            <span class="top-product-value">${formatCurrency(p.totalValue)}</span>
        </div>`;
    }).join('');
}


