}\n\nfunction renderDashboardAlerts() {
    const container = document.getElementById('dashboard-alerts');
    const alertProducts = products.filter(p => {
        const status = getStockStatus(p);
        return status.level !== 'ok';
    }).sort((a, b) => a.quantity - b.quantity);

    if (alertProducts.length === 0) {
        container.innerHTML = '<div class="alert-empty"><i class="fa-solid fa-circle-check"></i><span>Todos os produtos com estoque adequado</span></div>';
        return;
    }

    container.innerHTML = alertProducts.slice(0, 6).map(p => {
        const status = getStockStatus(p);
        const isCritical = status.level === 'critical' || status.level === 'empty';
        const iconClass = isCritical ? 'critical' : 'warning';
        const alertClass = isCritical ? '' : 'warning';
        const qtyClass = isCritical ? 'critical' : 'warning';

        return `<div class="alert-item ${alertClass}">
            <i class="fa-solid fa-${isCritical ? 'circle-exclamation' : 'triangle-exclamation'} alert-icon ${iconClass}"></i>
            <span class="alert-text"><strong>${p.name}</strong> â€” ${status.label}</span>
            <span class="alert-qty ${qtyClass}">${p.quantity} un</span>
        </div>`;
    }).join('');
}\r\n\r\nfunction executeDelete() {
