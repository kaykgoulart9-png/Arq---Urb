}\n\nfunction animateValue(elementId, target) {
    const el = document.getElementById(elementId);
    const current = parseInt(el.textContent) || 0;
    if (current === target) { el.textContent = target; return; }

    const duration = 600;
    const start = performance.now();

    function executeDelete() {
    if (!pendingDeleteId || !pendingDeleteType) return;

    if (pendingDeleteType === 'product') {
        const product = getProductById(pendingDeleteId);
        const movementsCount = movements.filter(m => m.productId === pendingDeleteId).length;
        if (movementsCount > 0) {
            showToast(`Não é possível excluir "${product?.name}" — existem ${movementsCount} movimentação(ões) associada(s).`, 'error');
            closeModal('confirm-modal');
            pendingDeleteId = null;
            pendingDeleteType = null;
            return;
        }

        products = products.filter(p => p.id !== pendingDeleteId);
        // Remover movimentos associados (opcional) - mantemos o comportamento original removendo também movimentos
        movements = movements.filter(m => m.productId !== pendingDeleteId);
        saveData(STORAGE_KEYS.products, products);
        saveData(STORAGE_KEYS.movements, movements);
        showToast(`Produto "${product?.name}" excluído`, 'warning');
        renderProducts();
    } else if (pendingDeleteType === 'category') {
        const cat = getCategoryById(pendingDeleteId);
        const hasProducts = products.some(p => p.categoryId === pendingDeleteId);
        if (hasProducts) {
            showToast('Remova todos os produtos desta categoria primeiro!', 'error');
        } else {
            categories = categories.filter(c => c.id !== pendingDeleteId);
            saveData(STORAGE_KEYS.categories, categories);
            showToast(`Categoria "${cat?.name}" excluída`, 'warning');
            renderCategories();
        }
    }

    pendingDeleteId = null;
    pendingDeleteType = null;
    closeModal('confirm-modal');
}\n\nfunction update(now) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(current + (target - current) * eased);
        if (progress < 1) requestAnimationFrame(update);
    }
    requestAnimationFrame(update);
}\r\n\r\nfunction executeDelete() {
