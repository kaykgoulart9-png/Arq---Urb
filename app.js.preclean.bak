const SAMPLE_MOVEMENTS = (() => {
    const movements = [];
    const now = new Date();
    const reasons_entry = ['Compra de fornecedor', 'DevoluÃ§Ã£o de cliente', 'Ajuste de inventÃ¡rio', 'TransferÃªncia entre unidades'];
    const reasons_exit = ['Venda', 'Quebra/Avaria', 'Vencimento', 'Consumo interno', 'Ajuste de inventÃ¡rio'];

    const entries = [
        { productId: 'p1', qty: 24, daysAgo: 6 },
        { productId: 'p4', qty: 48, daysAgo: 5 },
        { productId: 'p8', qty: 36, daysAgo: 4 },
        { productId: 'p3', qty: 6, daysAgo: 3 },
        { productId: 'p6', qty: 30, daysAgo: 2 },
        { productId: 'p7', qty: 12, daysAgo: 1 },
        { productId: 'p2', qty: 10, daysAgo: 0 },
    ];

    const exits = [
        { productId: 'p1', qty: 6, daysAgo: 5 },
        { productId: 'p4', qty: 12, daysAgo: 4 },
        { productId: 'p8', qty: 8, daysAgo: 3 },
        { productId: 'p12', qty: 10, daysAgo: 2, reason: 'Venda' },
        { productId: 'p9', qty: 2, daysAgo: 1, reason: 'Venda' },
        { productId: 'p13', qty: 5, daysAgo: 0, reason: 'Vencimento' },
    ];

    entries.forEach((entry, index) => {
        const date = new Date(now);
        date.setDate(date.getDate() - entry.daysAgo);
        date.setHours(9 + index, Math.floor(Math.random() * 59), 0);
        movements.push({
            id: `mov-e${index}`,
            productId: entry.productId,
            type: 'entry',
            quantity: entry.qty,
            reason: reasons_entry[Math.floor(Math.random() * reasons_entry.length)],
            notes: '',
            date: date.toISOString(),
        });
    });

    exits.forEach((exit, index) => {
        const date = new Date(now);
        date.setDate(date.getDate() - exit.daysAgo);
        date.setHours(14 + index, Math.floor(Math.random() * 59), 0);
        movements.push({
            id: `mov-x${index}`,
            productId: exit.productId,
            type: 'exit',
            quantity: exit.qty,
            reason: exit.reason || reasons_exit[Math.floor(Math.random() * reasons_exit.length)],
            notes: '',
            date: date.toISOString(),
        });
    });

    return movements.sort((a, b) => new Date(b.date) - new Date(a.date));
})();

// Storage helpers
function executeDelete() {
    if (!pendingDeleteId || !pendingDeleteType) return;

    if (pendingDeleteType === 'product') {
        const product = getProductById(pendingDeleteId);
        const movementsCount = movements.filter(m => m.productId === pendingDeleteId).length;
        if (movementsCount > 0) {
            showToast(`Não é possível excluir "${product?.name}" — existem ${movementsCount} movimentação(ões) associada(s).`, 'error');
            closeModal('confirm-modal');
            pendingDeleteId = null;
            pendingDeleteType = null;
            return;
        }
function generateId() {
    // Mais robusto: combina timestamp + duas partes aleatórias para evitar colisões
    const timestamp = Date.now().toString(36);
    const randomPart = Math.random().toString(36).substring(2, 8);
    const microsPart = Math.floor(Math.random() * 1000000).toString(36);
    return 'id-' + timestamp + '-' + randomPart + '-' + microsPart;
}
// Initialize data
let categories = loadData(STORAGE_KEYS.categories, null);
let products = loadData(STORAGE_KEYS.products, null);
let movements = loadData(STORAGE_KEYS.movements, null);

if (!categories) { categories = [...DEFAULT_CATEGORIES]; saveData(STORAGE_KEYS.categories, categories); }
if (!products) { products = [...SAMPLE_PRODUCTS]; saveData(STORAGE_KEYS.products, products); }
if (!movements) { movements = [...SAMPLE_MOVEMENTS]; saveData(STORAGE_KEYS.movements, movements); }


// ============ UTILITIES ============

function executeDelete() {
    if (!pendingDeleteId || !pendingDeleteType) return;

    if (pendingDeleteType === 'product') {
        const product = getProductById(pendingDeleteId);
        const movementsCount = movements.filter(m => m.productId === pendingDeleteId).length;
        if (movementsCount > 0) {
            showToast(`Não é possível excluir "${product?.name}" — existem ${movementsCount} movimentação(ões) associada(s).`, 'error');
            closeModal('confirm-modal');
            pendingDeleteId = null;
            pendingDeleteType = null;
            return;
        }

        products = products.filter(p => p.id !== pendingDeleteId);
        // Remover movimentos associados (opcional) - mantemos o comportamento original removendo também movimentos
        movements = movements.filter(m => m.productId !== pendingDeleteId);
        saveData(STORAGE_KEYS.products, products);
        saveData(STORAGE_KEYS.movements, movements);
        showToast(`Produto "${product?.name}" excluído`, 'warning');
        renderProducts();
    } else if (pendingDeleteType === 'category') {
        const cat = getCategoryById(pendingDeleteId);
        const hasProducts = products.some(p => p.categoryId === pendingDeleteId);
        if (hasProducts) {
            showToast('Remova todos os produtos desta categoria primeiro!', 'error');
        } else {
            categories = categories.filter(c => c.id !== pendingDeleteId);
            saveData(STORAGE_KEYS.categories, categories);
            showToast(`Categoria "${cat?.name}" excluída`, 'warning');
            renderCategories();
        }
    }

    pendingDeleteId = null;
    pendingDeleteType = null;
    closeModal('confirm-modal');
